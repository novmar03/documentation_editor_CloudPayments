":{"textAlign":null},"content":[{"type":"text","text":"Name_TooLong"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Cardholder name is too long *"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Name_TooShort"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Cardholder name is too short *"}]}]}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Notice:"},{"type":"text","text":" The "},{"type":"text","marks":[{"type":"code"}],"text":"name"},{"type":"text","text":" field is optional and is validated only if it is specified in the form or provided in the "},{"type":"text","marks":[{"type":"code"}],"text":"CardData"},{"type":"text","text":" object. "}]},{"type":"heading","attrs":{"textAlign":null,"id":"section-03f2bcac-7904-4775-a5e3-87ce8f9dc659","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Cryptogram generation method"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"The method returns a cryptogram upon successful generation or an object with a list of errors if card details contain any errors. Unlike the "},{"type":"text","marks":[{"type":"code"}],"text":"createPaymentCryptogram"},{"type":"text","text":" method, this error object contains localized Russian error descriptions instead of error codes."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"code"}],"text":"createCryptogramPacket(fieldValues: CardData):string of the object"},{"type":"text","text":" — deprecated."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"This method accepts an object with card details and can be used in the legacy HTML form binding implementation. If a form binding is used and the same parameter is found in the "},{"type":"text","marks":[{"type":"code"}],"text":"CardData"},{"type":"text","text":" object, an error will be thrown when attempting to generate the cryptogram."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Script for cryptogram generation:"}]},{"type":"codeBlock","attrs":{"language":"javascript"},"content":[{"type":"text","text":"this.createCryptogram = function () {\n    var result = checkout.createCryptogramPacket();\n\n    if (result.success) {\n        // The cryptogram is generated\n        alert(result.packet);\n    }\n    else {\n        // Input data validation failed; the `result.messages` object is formatted as follows:\n        // { name: \"The cardholder name contains too many characters\", cardNumber: \"Invalid Card Number\" }\n        // Where `name` and `cardNumber` correspond to the values of the `<input ... data-cp=\"cardNumber\">` attributes\n\n        for (var msgName in result.messages) {\n            alert(result.messages[msgName]);\n        }\n    }\n};\n\n$(function () {\n    /* checkout initialization */\n    checkout = new cp.Checkout(\n        // Public ID from the dashboard\n        \"test_api_00000000000000000000001\",\n        // The tag that contains the card details fields\n        document.getElementById(\"paymentFormSample\")\n    );\n});"}]},{"type":"paragraph","attrs":{"textAlign":null}}]}}