idth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"number"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"No"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Recurring payment amount. By default, this matches the initial payment amount. If specifying a custom amount, ensure it is greater than 0"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"StartDate"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"DateTime"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"No"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Date and time of the first recurring payment. By default, the next payment will occur after the specified interval and period. If specifying a custom date, ensure it is set in the future"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"CustomerReceipt"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"string"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"No"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Data for online receipts generation in recurring payments"}]}]}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"The parameters for launching recurring payments must be added to the "},{"type":"text","marks":[{"type":"code"}],"text":"data.CloudPayments.recurrent"},{"type":"text","text":" object, as shown in the example below:"}]},{"type":"codeBlock","attrs":{"language":"text"},"content":[{"type":"text","text":"this.pay = function () {\n    var widget = new cp.CloudPayments();\n    var receipt = {\n        Items: [// Receipt items\n            {\n                label: 'Product name 3', // Product name\n                price: 300.00, // Cost\n                quantity: 3.00, // Quantity\n                amount: 900.00, // Amount\n                vat: 20, // VAT rate\n                method: 0, // Tag 1214: payment method flag\n                object: 0, // Tag 1212: payment subject flag\n            }\n        ],\n        taxationSystem: 0,\n        email: 'user@example.com',\n        phone: '+71234567890',\n        isBso: false,\n        amounts: {\n            electronic: 900.00,\n            advancePayment: 0.00,\n            credit: 0.00,\n            provision: 0.00\n        }\n    };\n\n    var data = {};\n    data.CloudPayments = {\n        CustomerReceipt: receipt,\n        recurrent: {\n            interval: 'Month',\n            period: 1,\n            customerReceipt: receipt\n        }\n    };\n\n    widget.charge({\n        publicId: 'test_api_00000000000000000000001',\n        description: 'Monthly subscription for access to example.com',\n        amount: 1000,\n        currency: 'RUB',\n        invoiceId: '1234567',\n        accountId: 'user@example.com',\n        data: data\n    },\n    function (options) {\n        // Triggered on payment success\n    },\n    function (reason, options) {\n        // Triggered on payment failure\n    });\n};"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Please note that you can create a subscription by specifying the "},{"type":"text","marks":[{"type":"code"}],"text":"accountId"},{"type":"text","text":" parameter, which can be an email address, a phone number, or any other payer ID."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"For more examples of creating recurring payments from the widget, see the Integration scenarios."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"To cancel recurring payments, use the merchant dashboard, the API, or provide the customer with a link to the system's website:"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"link","attrs":{"href":"https://my.cloudpayments.ru/","target":"_blank","rel":"noopener noreferrer","class":null,"title":null}}],"text":"https://my.cloudpayments.ru/"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"There they can find and cancel their subscriptions independently. _Widget"}]},{"type":"heading","attrs":{"textAlign":null,"id":"section-cf567e9f-9150-4691-8f7a-b67bbb4e0651","level":2},"content":[{"type":"text","text":"Mobile widget"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"The script automatically identifies the user's device and launches the most appropriate widget: desktop or mobile. For the convenience of customers, the mobile version of the widget opens in full screen, allowing them to pay either by card or via one of the alternative payment methods."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Image: "},{"type":"text","marks":[{"type":"code"}],"text":"mobile-widget"},{"type":"hardBreak"},{"type":"text","marks":[{"type":"code"}],"text":"images/mobile-widget-ios.png"},{"type":"text","text":" _Widget"}]}]}}