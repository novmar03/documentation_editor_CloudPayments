{"id":"platezhniy-widget","locale":"en","title":"Payment widget","updated":"2026-09-25T18:02:42.944Z","baseHtml":"","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Payment widget is a pop-up form used to enter the payer's card details and email address. The widget automatically determines the type of payment network: Visa, Mastercard, Maestro, or Mir, as well as the issuing bank, and displays the corresponding logos. The form is optimized for all browsers and mobile devices. Inside the widget, an "},{"type":"text","marks":[{"type":"code"}],"text":"iframe"},{"type":"text","text":" opens that ensures the secure transmission of card details and does not require compliance certification from the merchant. _Widget"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Detailed developer documentation: "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://widget.cloudpayments.ru/docs/widget.html","target":"_blank","rel":"noopener noreferrer","class":null,"title":null}}],"text":"https://widget.cloudpayments.ru/docs/widget.html"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Demo of the payment form builder: "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://widget.cloudpayments.ru/app/demo","target":"_blank","rel":"noopener noreferrer","class":null,"title":null}}],"text":"https://widget.cloudpayments.ru/app/demo"}]},{"type":"heading","attrs":{"textAlign":null,"id":"section-ff8466f0-12f9-4dd4-951f-858e6fb3b0bc","level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Demo widget"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"A demonstration of how the Widget works is available in our "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://show.cloudpayments.ru/widget/","target":"_blank","rel":"noopener noreferrer","class":null,"title":null}}],"text":"demo store"},{"type":"text","text":":"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"You can use both test card details and real ones for testing. No funds will be debited. "}]},{"type":"image","attrs":{"src":"","alt":"Снимок экрана — 2026-09-25 в 21.02.16.png","title":null,"width":100,"height":null,"imageId":"1a4da9dd-b6e1-4413-9eef-ccf73cd1babd","caption":"","assetPath":"editor-assets/5e51bd16-65b1-405f-89ad-75216c293766.png","align":"center"}},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Embedded demo: "},{"type":"text","marks":[{"type":"code"}],"text":"pages/demo_widget.html"},{"type":"text","text":" _Widget "}]},{"type":"heading","attrs":{"textAlign":null,"id":"section-30790ef7-4e0b-4f90-b2f6-d026b3207b67","level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Widget installation"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"To install the widget, add the script to the "},{"type":"text","marks":[{"type":"bold"}],"text":"head"},{"type":"text","text":" section of your website:"}]},{"type":"codeBlock","attrs":{"language":"javascript"},"content":[{"type":"text","text":"<script src=\"https://widget.cloudpayments.ru/bundles/cloudpayments.js\"></script>"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Warning:"},{"type":"text","text":" Use "},{"type":"text","marks":[{"type":"code"}],"text":"cloudpayments.js"},{"type":"text","text":" to maintain PCI compliance by ensuring that payment details are sent directly to CloudPayments without affecting your server. Always load "},{"type":"text","marks":[{"type":"code"}],"text":"cloudpayments.js"},{"type":"text","text":" from "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://widget.cloudpayments.ru","target":"_blank","rel":"noopener noreferrer","class":null,"title":null}}],"text":"https://widget.cloudpayments.ru"},{"type":"text","text":" to remain compliant. Do not bundle the script or host it yourself. _Widget"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"To display the payment form, register a function to call the "},{"type":"text","marks":[{"type":"bold"}],"text":"pay"},{"type":"text","text":" method by passing either the "},{"type":"text","marks":[{"type":"code"}],"text":"auth"},{"type":"text","text":" or the "},{"type":"text","marks":[{"type":"code"}],"text":"charge"},{"type":"text","text":" parameter to it:"}]},{"type":"codeBlock","attrs":{"language":"text"},"content":[{"type":"text","text":"this.pay = function () {\n var widget = new cp.CloudPayments();\n    widget.pay('auth', // or 'charge'\n        { //options\n            publicId: 'test_api_00000000000000000000002', // ID from the dashboard\n            description: 'Payment for goods at example.com', // Payment description\n            amount: 100, // Amount\n            currency: 'RUB', // Currency\n            accountId: 'user@example.com', // Payer ID (optional)\n            invoiceId: '1234567', // Order number (optional)\n            email: 'user@example.com', // Payer email (optional)\n            skin: \"mini\", // Widget design (optional)\n            autoClose: 3, // Time in seconds before widget auto-close (optional)\n            data: {\n                myProp: 'myProp value'\n            },\n            configuration: {\n                common: {\n                    successRedirectUrl: \"https://{your website}/success\", // Redirection URL\n                    failRedirectUrl: \"https://{your website}/fail\"        // If paid via T-Pay\n                }\n            },\n            payer: {\n                firstName: 'Test',\n                lastName: 'Testov',\n                middleName: 'Testovich',\n                birth: '1955-02-24',\n                address: 'test drive test home',\n                street: 'Lenina',\n                city: 'MO',\n                country: 'RU',\n                phone: '+71234567890',\n                postcode: '345'\n            }\n        },\n        {\n            onSuccess: function (options) { // Success\n                // Triggered on payment success\n            },\n            onFail: function (reason, options) { // Fail\n                // Triggered on payment failure\n            },\n            onComplete: function (paymentResult, options) {\n                // Triggered as soon as the widget receives a response\n                // with transaction result from api.cloudpayments\n                // For example, calling your analytics\n            }\n        }\n    )\n};"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Then, call the function in response to an event, such as clicking the Pay button:"}]},{"type":"codeBlock","attrs":{"language":"text"},"content":[{"type":"text","text":"$('#checkout').click(pay);"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Notice:"},{"type":"text","text":" The example uses the jQuery library."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"A demonstration of how the widget works is available in our demo store:"},{"type":"hardBreak"},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://show.cloudpayments.ru","target":"_blank","rel":"noopener noreferrer","class":null,"title":null}}],"text":"https://show.cloudpayments.ru"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Example of running the widget without jQuery:"}]},{"type":"codeBlock","attrs":{"language":"text"},"content":[{"type":"text","text":"document.querySelector('#checkout').onclick = pay"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Embedded JSFiddle:"}]},{"type":"codeBlock","attrs":{"language":"text"},"content":[{"type":"text","text":"<script async src=\"//jsfiddle.net/tretyakovsky/xvec6jpb/35/embed/js,html/dark/\"></script>"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"You can use both test card details and real ones for testing. No funds will be debited. _Widget"}]},{"type":"heading","attrs":{"textAlign":null,"id":"section-da03242d-3f33-492b-9a10-14f5d6d1168f","level":2},"content":[{"type":"text","text":"Parameters"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Notice:"},{"type":"text","text":" According to the NSPK requirements, merchant platforms providing telecommunication services (MCC 4814 Telecommunication Services), must provide the payer's phone number. If the phone number is missing from the request, acquiring banks will decline the transactions."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"The phone number must be passed in the "},{"type":"text","marks":[{"type":"code"}],"text":"Phone"},{"type":"text","text":" parameter within the "},{"type":"text","marks":[{"type":"code"}],"text":"Payer"},{"type":"text","text":" object."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Format: digits only, without delimiters such as hyphens or parentheses."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Example: "},{"type":"text","marks":[{"type":"code"}],"text":"+71234567890"},{"type":"text","text":" _Widget"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Calling the pay function with either the "},{"type":"text","marks":[{"type":"code"}],"text":"auth"},{"type":"text","text":" or the "},{"type":"text","marks":[{"type":"code"}],"text":"charge"},{"type":"text","text":" argument determines the payment processing method:"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"cha